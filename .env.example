# Copy to .env and fill in values. .env is git-ignored — never commit real credentials.

MYSQL_DATABASE=ticketmanagement
MYSQL_USER=ticketmanagement
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

APP_PORT=8080

# Frontend (see docker-compose.yml `frontend` service). FRONTEND_PORT is the
# host-exposed port; API_BASE_URL is server-side only (used by the Next.js
# server's Route Handlers), left as the Compose service DNS name below — do
# not set this to localhost or a real host, and never commit a real value.
FRONTEND_PORT=3000
API_BASE_URL=http://app:8080
